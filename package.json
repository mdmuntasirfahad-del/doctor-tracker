{
  "name": "doctor-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/dev-preflight.mjs",
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "npm run seed -w server",
    "indexes": "npm run indexes -w server",
    "promote-admin": "npm run promote-admin -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "next": "^16.4.4",
    "prettier": "^3.7.4"
  }
}

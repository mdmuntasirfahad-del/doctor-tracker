# Local development secrets (copied to client/.env and server/.env)
# Generate a strong secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# MongoDB (use 127.0.0.1 to avoid IPv6 resolution issues)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=doctor_tracker

# Express API
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Client (only NEXT_PUBLIC_* is exposed to the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000

# Seeded administrator (never use these values in production)
SEED_ADMIN_NAME=Alex Lee
SEED_ADMIN_EMAIL=alex.lee@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Server only (never expose to the client or prefix with NEXT_PUBLIC_)
IMGBB_API_KEY=your_imgbb_api_key
